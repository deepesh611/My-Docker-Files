# Copy to widget-secrets.yaml and fill in real values.
# https://gethomepage.dev/widgets/services/
#
# Keys are matched by widget type and/or container name.
# Never commit widget-secrets.yaml.

portainer:
  # From Portainer → Environments → open env → URL ends with /endpoints/<id>
  env: 3
  # Create at Portainer → Account Settings → Access tokens
  key: ptr_REPLACE_ME

# Optional per-container overrides:
# containers:
#   portainer:
#     env: 3
#     key: ptr_REPLACE_ME
